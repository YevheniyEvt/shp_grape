# Copy to .env and adjust. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (used by docker-compose.yml and Django)
POSTGRES_DB=shp_grape
POSTGRES_USER=shp_grape
POSTGRES_PASSWORD=shp_grape
POSTGRES_PORT=5432
DATABASE_URL=postgres://shp_grape:shp_grape@localhost:5432/shp_grape

# Superuser for local development (used by later seed commands)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
